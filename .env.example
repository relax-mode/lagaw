# Backend only. Copy this file to .env at the repository root.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000

# Optional team-controlled, real-provenance hybrid JSON artifact accessible to the
# backend process. Leave unset for content recommendations; no artifact is required.
# Restart the backend after changing the path or artifact. Never use fixture models.
# MODEL_FILE_PATH=

# Cloudflare Pages deploys via Wrangler (DevOps). CI reads these from GitHub Actions secrets;
# set them here only to deploy by hand. Never commit real values.
CLOUDFLARE_API_TOKEN=your_cloudflare_pages_edit_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# PostgreSQL connection for SQLAlchemy only; locations/trips use the Data API below.
# For development, copy the test project's Session pooler URI from Connect.
# Use postgresql+psycopg:// and URL-encode reserved characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Reserved; these backend APIs do not use this. Flutter calls FastAPI, not Supabase.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Required for locations/trips. Use your backend secret (sb_secret_) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Issue #23 controlled demo context. Blank settings disable the trip endpoints.
# Provision a dedicated public.users profile in the SAME Supabase project first.
# Token must be a random ASCII secret of at least 32 characters. The deployed
# web build receives it at build time and exposes it in the public bundle.
TRIP_DEMO_USER_ID=
TRIP_DEMO_TOKEN=

# Backend CORS: exact frontend origins, separated by commas, with no trailing slash.
# Local Flutter Web uses a fixed port: flutter run -d chrome --web-port 3000
# On the backend host, replace these with the actual HTTPS frontend origin(s).
# Unset/empty permits no cross-origin browser reads. Do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
